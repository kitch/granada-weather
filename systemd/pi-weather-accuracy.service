[Unit]
Description=Score Granada Weather forecasts against station observations
After=pi-weather.service
Requires=pi-weather.service

[Service]
Type=oneshot
User=jakekit
Environment=WEATHER_DATA_DIR=/var/lib/pi-weather
EnvironmentFile=/etc/pi-weather.env
ExecStart=/usr/bin/python3 /opt/pi-weather/accuracy_collector.py

