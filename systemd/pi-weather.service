[Unit]
Description=Local WS-2000 weather receiver
After=network.target

[Service]
Type=simple
User=jakekit
WorkingDirectory=/opt/pi-weather
Environment=WEATHER_DATA_DIR=/var/lib/pi-weather
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/pi-weather.env
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
ExecStart=/usr/bin/python3 /opt/pi-weather/server.py --port 80
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
