# Station receiver authentication
WEATHER_STATION_ID=replace-me
WEATHER_STATION_KEY=replace-me

# Location and local time
LAT=35.77194
LON=-78.63889
WEATHER_TIMEZONE=America/New_York

# Forecast providers (optional)
OPENWEATHER_API_KEY=
WUNDERGROUND_API_KEY=

# Forward observations to Weather Underground (optional)
WUNDERGROUND_STATION_ID=
WUNDERGROUND_STATION_KEY=

# Apple WeatherKit (optional)
WEATHERKIT_TEAM_ID=
WEATHERKIT_KEY_ID=
WEATHERKIT_SERVICE_ID=
WEATHERKIT_KEY_FILE=/etc/pi-weather/weatherkit.p8

# TRMNL private-plugin webhook (optional)
TERMINAL_WEBHOOK_URL=

